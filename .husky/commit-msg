#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# 커밋 메시지 파일
COMMIT_MSG_FILE="$1"

# 첫 번째 줄 가져오기
COMMIT_MSG=$(head -n 1 "$COMMIT_MSG_FILE")

# =========================
# 1. 커밋 제목 형식 검사
# =========================

if ! echo "$COMMIT_MSG" | grep -qE '^(Asset|Design|Build|Chore|Ci|Docs|Feat|Fix|Perf|Refactor|Revert|Style|Test)(\(.+\))?!?: .+'; then
    echo "❌ 커밋 메시지 제목 형식이 올바르지 않습니다."
    echo ""
    echo "형식:"
    echo "  Type: 설명"
    echo ""
    echo "사용 가능한 Type:"
    echo "  Asset, Design, Build, Chore, Ci, Docs"
    echo "  Feat, Fix, Perf, Refactor, Revert, Style, Test"
    echo ""
    echo "예시:"
    echo "  Feat: 플레이어 이동 기능 추가"
    echo "  Fix: 총알 충돌 오류 수정"
    echo "  Docs: README 수정"
    echo "  Refactor(Player): 플레이어 이동 코드 리팩토링"
    exit 1
fi

# =========================
# 2. 커밋 본문 검사
# =========================

body_lines=$(awk '
    NR > 1 &&
    $0 !~ /^[[:space:]]*$/ &&
    $0 !~ /^#/ {
        count++
    }
    END {
        print count + 0
    }
' "$COMMIT_MSG_FILE")

if [ "$body_lines" -lt 1 ]; then
    echo "❌ 커밋 메시지 본문은 최소 1줄 이상 작성해야 합니다."
    echo "   빈 줄과 주석(#)은 본문으로 인정되지 않습니다."
    exit 1
fi

# =========================
# 3. Type 추출
# =========================

TYPE=$(echo "$COMMIT_MSG" | sed -E 's/^([A-Za-z]+).*/\1/')

# =========================
# 4. Type에 따른 이모지 설정
# =========================

case "$TYPE" in
    Asset)
        EMOJI="🎨"
        ;;
    Design)
        EMOJI="🎨"
        ;;
    Build)
        EMOJI="📦"
        ;;
    Chore)
        EMOJI="🔧"
        ;;
    Ci)
        EMOJI="👷"
        ;;
    Docs)
        EMOJI="📝"
        ;;
    Feat)
        EMOJI="✨"
        ;;
    Fix)
        EMOJI="🐛"
        ;;
    Perf)
        EMOJI="⚡"
        ;;
    Refactor)
        EMOJI="♻️"
        ;;
    Revert)
        EMOJI="⏪"
        ;;
    Style)
        EMOJI="💄"
        ;;
    Test)
        EMOJI="✅"
        ;;
esac

# =========================
# 5. 제목 앞에 이모지 추가
# =========================

TEMP_FILE="${COMMIT_MSG_FILE}.tmp"

{
    echo "$EMOJI $COMMIT_MSG"
    tail -n +2 "$COMMIT_MSG_FILE"
} > "$TEMP_FILE"

mv "$TEMP_FILE" "$COMMIT_MSG_FILE"

exit 0